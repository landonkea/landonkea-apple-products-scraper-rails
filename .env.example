# Copy this file to .env and fill in real values. .env itself is
# git-ignored (see .gitignore) so your real webhook URLs never get
# committed to GitHub -- only this .env.example template (with no real
# secrets in it) is tracked.

# The Discord webhook that new/great-deal and price-drop alerts for
# MacBook Pro, iPhone Pro Max, and iPad Pro get posted to, in the
# `production` Rails environment. Get this from Discord: Server
# Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook
# URL. Leave this unset and the app still runs fine, it'll just log
# that it would have posted instead of actually posting.
DISCORD_WEBHOOK_URL=

# The webhook used instead of the one above whenever RAILS_ENV is NOT
# "production" (development, test, or the staging environment) -- a
# safety net so a local run or a staging deploy can never accidentally
# post to your real production Discord channel. Point this at a
# throwaway/testing channel. Unset means non-production runs just log
# what they would have sent.
DISCORD_WEBHOOK_URL_DEV=

# A SEPARATE webhook, for the e-bike search only, so those alerts land
# in a different channel than the Apple hardware alerts above. Unset
# means e-bike alerts are skipped with a log line, not an error.
DISCORD_WEBHOOK_URL_EBIKE=

# Non-production counterpart to DISCORD_WEBHOOK_URL_EBIKE, same
# "_DEV" pattern as DISCORD_WEBHOOK_URL_DEV above.
DISCORD_WEBHOOK_URL_EBIKE_DEV=

# Optional: comma-separated Craigslist region slugs to search, e.g.
# "phoenix,tucson,losangeles". Craigslist is organized by metro area,
# not by state, so this can list several to cover more ground in one
# run. Leave unset and it defaults to just "phoenix".
CRAIGSLIST_REGIONS=

# Optional: full path to a Chrome/Chromium binary, only needed if
# Ferrum (the headless-browser gem used for eBay, Back Market, Mercari,
# Best Buy, and OfferUp, the marketplaces whose listings only appear
# after JavaScript runs) can't find one on its own. The Docker image
# sets this automatically -- you'd only set it locally if you have
# Chrome installed somewhere non-standard.
BROWSER_PATH=
